{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "perf": "error",
    "suspicious": "error"
  },
  "ignorePatterns": [
    ".expo/**",
    ".next/**",
    ".turbo/**",
    "dist/**",
    "node_modules/**",
    "apps/*/.next/**",
    "apps/*/.expo/**",
    "apps/*/dist/**",
    "apps/mobile/drizzle/**",
    "apps/web/next-env.d.ts"
  ],
  "options": {
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error",
    "typeAware": true
  },
  "plugins": ["import", "oxc", "typescript", "unicorn"],
  "jsPlugins": ["./scripts/linting/index.mjs"],
  "settings": {
    "next": {
      "rootDir": "apps/web/"
    }
  },
  "rules": {
    "eqeqeq": "error",
    "curly": ["error", "all"],
    "no-console": "error",
    "no-debugger": "error",
    "no-duplicate-imports": "error",
    "no-nested-ternary": "error",
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css", "server-only"]
      }
    ],
    "unicorn/custom-error-definition": "off",
    "unicorn/no-await-expression-member": "error",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "importNames": ["useMemo"],
            "message": "React Compiler handles memoization; do not add manual memoization.",
            "name": "react"
          }
        ]
      }
    ],
    "typescript/consistent-type-imports": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-deprecated": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unused-vars": "error"
  },
  "overrides": [
    {
      "files": [
        "apps/mobile/src/**/*.ts",
        "apps/mobile/src/**/*.tsx",
        "apps/web/src/**/*.ts",
        "apps/web/src/**/*.tsx"
      ],
      "rules": {
        "flashcards/require-react-component-props-type": "error",
        "flashcards/require-react-hook-options-type": "error"
      }
    },

    {
      "files": ["apps/web/**/*.ts", "apps/web/**/*.tsx"],
      "plugins": [
        "import",
        "jsx-a11y",
        "nextjs",
        "oxc",
        "react",
        "react-perf",
        "typescript",
        "unicorn"
      ],
      "rules": {
        "react/jsx-no-useless-fragment": "error",
        "react/exhaustive-deps": "error",
        "react/exhaustive-effect-dependencies": "off",
        "react/jsx-no-constructed-context-values": "off",
        "react/no-unstable-nested-components": [
          "error",
          {
            "allowAsProps": true
          }
        ],
        "react/no-array-index-key": "error",
        "react/react-in-jsx-scope": "off",
        "react/style-prop-object": "off",
        "react-perf/jsx-no-new-array-as-prop": "off",
        "react-perf/jsx-no-new-function-as-prop": "off",
        "react-perf/jsx-no-new-object-as-prop": "off"
      }
    },
    {
      "files": ["apps/mobile/tests/**/*.{test,spec}.{js,jsx,ts,tsx}"],
      "env": {
        "vitest": true
      },
      "plugins": ["import", "oxc", "react", "react-perf", "typescript", "unicorn", "vitest"],
      "rules": {
        "react/jsx-no-useless-fragment": "error",
        "react/exhaustive-deps": "error",
        "react/exhaustive-effect-dependencies": "off",
        "react/jsx-no-constructed-context-values": "off",
        "react/no-unstable-nested-components": [
          "error",
          {
            "allowAsProps": true
          }
        ],
        "react/no-array-index-key": "error",
        "react/react-in-jsx-scope": "off",
        "react/style-prop-object": "off",
        "react-perf/jsx-no-new-array-as-prop": "off",
        "react-perf/jsx-no-new-function-as-prop": "off",
        "react-perf/jsx-no-new-object-as-prop": "off",
        "vitest/require-mock-type-parameters": "off",
        "vitest/require-to-throw-message": "off",
        "vitest/valid-expect": "off"
      }
    },
    {
      "files": ["apps/web/tests/**/*.{test,spec}.{js,jsx,ts,tsx}"],
      "env": {
        "vitest": true
      },
      "plugins": [
        "import",
        "jsx-a11y",
        "nextjs",
        "oxc",
        "react",
        "react-perf",
        "typescript",
        "unicorn",
        "vitest"
      ],
      "rules": {
        "react/jsx-no-useless-fragment": "error",
        "react/exhaustive-deps": "error",
        "react/exhaustive-effect-dependencies": "off",
        "react/jsx-no-constructed-context-values": "off",
        "react/no-unstable-nested-components": [
          "error",
          {
            "allowAsProps": true
          }
        ],
        "react/no-array-index-key": "error",
        "react/react-in-jsx-scope": "off",
        "react/style-prop-object": "off",
        "react-perf/jsx-no-new-array-as-prop": "off",
        "react-perf/jsx-no-new-function-as-prop": "off",
        "react-perf/jsx-no-new-object-as-prop": "off",
        "vitest/require-mock-type-parameters": "off",
        "vitest/require-to-throw-message": "off",
        "vitest/valid-expect": "off"
      }
    },
    {
      "files": ["scripts/**/*.{js,cjs,mjs}", "apps/mobile/scripts/**/*.{js,cjs,mjs}"],
      "env": {
        "node": true
      },
      "plugins": ["import", "node", "oxc", "unicorn"],
      "rules": {
        "no-await-in-loop": "off",
        "no-console": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/require-array-sort-compare": "off"
      }
    },
    {
      "files": ["apps/mobile/src/**/*.ts", "apps/mobile/src/**/*.tsx"],
      "plugins": ["import", "oxc", "react", "react-perf", "typescript", "unicorn"],
      "rules": {
        "react/jsx-no-useless-fragment": "error",
        "react/exhaustive-deps": "error",
        "react/exhaustive-effect-dependencies": "off",
        "react/jsx-no-constructed-context-values": "off",
        "react/no-unstable-nested-components": [
          "error",
          {
            "allowAsProps": true
          }
        ],
        "react/no-array-index-key": "error",
        "react/react-in-jsx-scope": "off",
        "react/style-prop-object": "off",
        "react-perf/jsx-no-new-array-as-prop": "off",
        "react-perf/jsx-no-new-function-as-prop": "off",
        "react-perf/jsx-no-new-object-as-prop": "off"
      }
    },
    {
      "files": ["apps/mobile/src/features/*/domain/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "importNames": ["useMemo"],
                "message": "React Compiler handles memoization; do not add manual memoization.",
                "name": "react"
              },
              {
                "name": "zod",
                "message": "Validate serialized data at the boundary, not in the domain."
              },
              {
                "name": "better-sqlite3",
                "message": "Domain code must remain persistence independent."
              }
            ],
            "patterns": [
              {
                "regex": "^@/features/[^/]+/(application|infrastructure|presentation)(/|$)",
                "message": "Domain code cannot depend on application, infrastructure, or presentation."
              },
              {
                "regex": "^@/shared/(application|infrastructure|presentation)(/|$)",
                "message": "Domain code may only use framework-neutral shared domain code."
              },
              {
                "regex": "^@/infrastructure(/|$)",
                "message": "Domain code cannot import infrastructure."
              },
              {
                "group": [
                  "react",
                  "react/**",
                  "react-native",
                  "react-native/**",
                  "expo-*",
                  "@expo/**",
                  "drizzle-orm",
                  "drizzle-orm/**"
                ],
                "message": "Domain code must remain framework independent."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/mobile/src/features/*/application/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "importNames": ["useMemo"],
                "message": "React Compiler handles memoization; do not add manual memoization.",
                "name": "react"
              },
              {
                "name": "better-sqlite3",
                "message": "Application code must remain persistence independent."
              }
            ],
            "patterns": [
              {
                "regex": "^@/features/[^/]+/(infrastructure|presentation)(/|$)",
                "message": "Application code cannot depend on infrastructure or presentation."
              },
              {
                "regex": "^@/shared/(infrastructure|presentation)(/|$)",
                "message": "Application code cannot depend on infrastructure or presentation."
              },
              {
                "regex": "^@/infrastructure(/|$)",
                "message": "Application code cannot import infrastructure."
              },
              {
                "group": [
                  "react",
                  "react/**",
                  "react-native",
                  "react-native/**",
                  "expo-*",
                  "@expo/**",
                  "drizzle-orm",
                  "drizzle-orm/**"
                ],
                "message": "Application code must remain framework independent."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "apps/mobile/src/features/*/infrastructure/**/*.{ts,tsx}",
        "apps/mobile/src/infrastructure/**/*.{ts,tsx}"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "importNames": ["useMemo"],
                "message": "React Compiler handles memoization; do not add manual memoization.",
                "name": "react"
              }
            ],
            "patterns": [
              {
                "regex": "^@/features/[^/]+/presentation(/|$)",
                "message": "Infrastructure cannot depend on presentation."
              },
              {
                "regex": "^@/shared/presentation(/|$)",
                "message": "Infrastructure cannot depend on presentation."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "apps/mobile/src/features/*/presentation/**/*.{ts,tsx}",
        "apps/mobile/src/app/**/*.{ts,tsx}"
      ],
      "excludeFiles": [
        "apps/mobile/src/features/*/presentation/controllers/**/*",
        "apps/mobile/src/features/*/presentation/dependencies/**/*",
        "apps/mobile/src/app/_layout.tsx"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "importNames": ["useMemo"],
                "message": "React Compiler handles memoization; do not add manual memoization.",
                "name": "react"
              },
              {
                "name": "expo-sqlite",
                "message": "Presentation code must use an application capability instead of persistence."
              },
              {
                "name": "better-sqlite3",
                "message": "Presentation code must use an application capability instead of persistence."
              }
            ],
            "patterns": [
              {
                "regex": "^@/features/[^/]+/(application|infrastructure)(/|$)",
                "message": "Presentation code must consume controllers, not application or infrastructure implementations."
              },
              {
                "regex": "^@/shared/(application|infrastructure)(/|$)",
                "message": "Presentation code must not import application or infrastructure."
              },
              {
                "regex": "^@/infrastructure(/|$)",
                "message": "Presentation code must use an application capability instead of infrastructure."
              },
              {
                "group": ["drizzle-orm", "drizzle-orm/**"],
                "message": "Presentation code must use an application capability instead of persistence."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/mobile/src/features/*/presentation/controllers/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "importNames": ["useMemo"],
                "message": "React Compiler handles memoization; do not add manual memoization.",
                "name": "react"
              },
              {
                "name": "expo-sqlite",
                "message": "Presentation controllers must use application capabilities instead of persistence."
              },
              {
                "name": "better-sqlite3",
                "message": "Presentation controllers must use application capabilities instead of persistence."
              }
            ],
            "patterns": [
              {
                "regex": "^@/features/[^/]+/infrastructure(/|$)",
                "message": "Presentation controllers cannot import infrastructure implementations."
              },
              {
                "regex": "^@/shared/infrastructure(/|$)",
                "message": "Presentation controllers cannot import infrastructure implementations."
              },
              {
                "regex": "^@/infrastructure(/|$)",
                "message": "Presentation controllers cannot import infrastructure implementations."
              },
              {
                "group": ["drizzle-orm", "drizzle-orm/**"],
                "message": "Presentation controllers must use application capabilities instead of persistence."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/mobile/src/features/*/presentation/dependencies/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "importNames": ["useMemo"],
                "message": "React Compiler handles memoization; do not add manual memoization.",
                "name": "react"
              },
              {
                "name": "expo-sqlite",
                "message": "Presentation dependencies must use application capabilities instead of persistence."
              },
              {
                "name": "better-sqlite3",
                "message": "Presentation dependencies must use application capabilities instead of persistence."
              }
            ],
            "patterns": [
              {
                "regex": "^@/features/[^/]+/infrastructure(/|$)",
                "message": "Presentation dependencies cannot import infrastructure implementations."
              },
              {
                "regex": "^@/shared/infrastructure(/|$)",
                "message": "Presentation dependencies cannot import infrastructure implementations."
              },
              {
                "regex": "^@/infrastructure/(app-recovery|bundled-deck-installer|bundled-deck-packages|bundled-deck-version|deck-package-services|preferences-services|system-clock|uuid-generator|errors/|sqlite/)",
                "message": "Presentation dependencies may only access the application container from infrastructure."
              },
              {
                "group": ["drizzle-orm", "drizzle-orm/**"],
                "message": "Presentation dependencies must use application capabilities instead of persistence."
              }
            ]
          }
        ]
      }
    }
  ]
}
