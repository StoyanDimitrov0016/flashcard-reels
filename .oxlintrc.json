{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "perf": "error",
    "suspicious": "error"
  },
  "ignorePatterns": [".expo/**", ".next/**", ".turbo/**", "dist/**", "node_modules/**"],
  "options": {
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error",
    "typeAware": true
  },
  "plugins": ["import", "oxc", "typescript", "unicorn"],
  "jsPlugins": ["./scripts/linting/index.mjs"],
  "rules": {
    "curly": ["error", "all"],
    "eqeqeq": "error",
    "no-console": "error",
    "no-debugger": "error",
    "no-duplicate-imports": "error",
    "no-nested-ternary": "error",
    "no-param-reassign": "error",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "importNames": ["useMemo"],
            "message": "React Compiler handles memoization; do not add manual memoization.",
            "name": "react"
          }
        ]
      }
    ],
    "flashcards/no-await-in-ternary": "error",
    "import/no-cycle": "error",
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css", "server-only"]
      }
    ],
    "typescript/consistent-type-exports": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-deprecated": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": [
      "error",
      {
        "checksVoidReturn": {
          "attributes": false
        }
      }
    ],
    "typescript/no-non-null-assertion": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unused-vars": "error",
    "typescript/only-throw-error": "error",
    "typescript/prefer-nullish-coalescing": "error",
    "typescript/return-await": "error",
    "typescript/switch-exhaustiveness-check": [
      "error",
      {
        "considerDefaultExhaustiveForUnions": true
      }
    ],
    "unicorn/custom-error-definition": "off",
    "unicorn/no-await-expression-member": "error"
  },
  "overrides": [
    {
      "files": ["**/scripts/**/*.{js,cjs,mjs}"],
      "env": {
        "node": true
      },
      "rules": {
        "no-await-in-loop": "off",
        "no-console": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/require-array-sort-compare": "off"
      }
    }
  ]
}
