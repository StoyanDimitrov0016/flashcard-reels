{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "perf": "error",
    "suspicious": "error"
  },
  "ignorePatterns": [
    ".next/**",
    ".turbo/**",
    "node_modules/**",
    "apps/*/.next/**",
    "apps/*/.expo/**",
    "apps/*/dist/**",
    "apps/mobile/drizzle/**",
    "apps/web/next-env.d.ts"
  ],
  "options": {
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error",
    "typeAware": true
  },
  "plugins": ["import", "oxc", "typescript", "unicorn"],
  "jsPlugins": ["./scripts/linting/index.mjs"],
  "settings": {
    "next": {
      "rootDir": "apps/web/"
    }
  },
  "rules": {
    "eqeqeq": "error",
    "curly": ["error", "all"],
    "no-console": "error",
    "no-debugger": "error",
    "no-duplicate-imports": "error",
    "no-nested-ternary": "error",
    "unicorn/custom-error-definition": "off",
    "unicorn/no-await-expression-member": "error",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "importNames": ["useMemo"],
            "message": "React Compiler handles memoization; do not add manual memoization.",
            "name": "react"
          }
        ]
      }
    ],
    "typescript/consistent-type-imports": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-deprecated": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unused-vars": "error"
  },
  "overrides": [
    {
      "files": [
        "apps/mobile/src/**/*.ts",
        "apps/mobile/src/**/*.tsx",
        "apps/web/src/**/*.ts",
        "apps/web/src/**/*.tsx"
      ],
      "rules": {
        "flashcards/require-local-const-arrow-functions": "error",
        "flashcards/require-named-react-effect-callback": "error",
        "flashcards/require-named-react-effect-cleanup": "error",
        "flashcards/no-local-jsx-variables": "error",
        "flashcards/prefer-jsx-and": "error",
        "flashcards/require-react-component-props-type": "error"
      }
    },

    {
      "files": ["apps/web/**/*.ts", "apps/web/**/*.tsx"],
      "plugins": [
        "import",
        "jsx-a11y",
        "nextjs",
        "oxc",
        "react",
        "react-perf",
        "typescript",
        "unicorn"
      ],
      "rules": {
        "react/jsx-no-useless-fragment": "error",
        "react/exhaustive-deps": "error",
        "react/exhaustive-effect-dependencies": "off",
        "react/jsx-no-constructed-context-values": "off",
        "react/no-unstable-nested-components": [
          "error",
          {
            "allowAsProps": true
          }
        ],
        "react/no-array-index-key": "error",
        "react/react-in-jsx-scope": "off",
        "react/style-prop-object": "off",
        "react-perf/jsx-no-new-array-as-prop": "off",
        "react-perf/jsx-no-new-function-as-prop": "off",
        "react-perf/jsx-no-new-object-as-prop": "off"
      }
    },
    {
      "files": ["apps/mobile/tests/**/*.{test,spec}.{js,jsx,ts,tsx}"],
      "env": {
        "vitest": true
      },
      "plugins": ["import", "oxc", "react", "react-perf", "typescript", "unicorn", "vitest"],
      "rules": {
        "react/jsx-no-useless-fragment": "error",
        "react/exhaustive-deps": "error",
        "react/exhaustive-effect-dependencies": "off",
        "react/jsx-no-constructed-context-values": "off",
        "react/no-unstable-nested-components": [
          "error",
          {
            "allowAsProps": true
          }
        ],
        "react/no-array-index-key": "error",
        "react/react-in-jsx-scope": "off",
        "react/style-prop-object": "off",
        "react-perf/jsx-no-new-array-as-prop": "off",
        "react-perf/jsx-no-new-function-as-prop": "off",
        "react-perf/jsx-no-new-object-as-prop": "off",
        "vitest/require-mock-type-parameters": "off",
        "vitest/require-to-throw-message": "off",
        "vitest/valid-expect": "off"
      }
    },
    {
      "files": ["apps/web/tests/**/*.{test,spec}.{js,jsx,ts,tsx}"],
      "env": {
        "vitest": true
      },
      "plugins": [
        "import",
        "jsx-a11y",
        "nextjs",
        "oxc",
        "react",
        "react-perf",
        "typescript",
        "unicorn",
        "vitest"
      ],
      "rules": {
        "react/jsx-no-useless-fragment": "error",
        "react/exhaustive-deps": "error",
        "react/exhaustive-effect-dependencies": "off",
        "react/jsx-no-constructed-context-values": "off",
        "react/no-unstable-nested-components": [
          "error",
          {
            "allowAsProps": true
          }
        ],
        "react/no-array-index-key": "error",
        "react/react-in-jsx-scope": "off",
        "react/style-prop-object": "off",
        "react-perf/jsx-no-new-array-as-prop": "off",
        "react-perf/jsx-no-new-function-as-prop": "off",
        "react-perf/jsx-no-new-object-as-prop": "off",
        "vitest/require-mock-type-parameters": "off",
        "vitest/require-to-throw-message": "off",
        "vitest/valid-expect": "off"
      }
    },
    {
      "files": ["scripts/**/*.{js,cjs,mjs}", "apps/mobile/scripts/**/*.{js,cjs,mjs}"],
      "env": {
        "node": true
      },
      "plugins": ["import", "node", "oxc", "unicorn"],
      "rules": {
        "no-await-in-loop": "off",
        "no-console": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/require-array-sort-compare": "off"
      }
    },
    {
      "files": ["apps/mobile/src/**/*.ts", "apps/mobile/src/**/*.tsx"],
      "plugins": ["import", "oxc", "react", "react-perf", "typescript", "unicorn"],
      "rules": {
        "react/jsx-no-useless-fragment": "error",
        "react/exhaustive-deps": "error",
        "react/exhaustive-effect-dependencies": "off",
        "react/jsx-no-constructed-context-values": "off",
        "react/no-unstable-nested-components": [
          "error",
          {
            "allowAsProps": true
          }
        ],
        "react/no-array-index-key": "error",
        "react/react-in-jsx-scope": "off",
        "react/style-prop-object": "off",
        "react-perf/jsx-no-new-array-as-prop": "off",
        "react-perf/jsx-no-new-function-as-prop": "off",
        "react-perf/jsx-no-new-object-as-prop": "off",
        "flashcards/enforce-layer-boundaries": "error",
        "flashcards/no-feature-root-imports": "error",
        "flashcards/no-engine-policy-in-presentation": "error",
        "flashcards/no-persistence-orchestration-in-react-effect": "warn",
        "flashcards/no-ui-index-as-domain-position": "warn",
        "flashcards/no-zod-in-domain": "error",
        "flashcards/no-await-in-conditional-expression": "error"
      }
    }
  ]
}
