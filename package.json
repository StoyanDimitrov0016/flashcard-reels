{
  "name": "flashcard-reels",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:mobile": "turbo run dev --filter=@flashcard-reels/mobile",
    "dev:web": "turbo run dev --filter=@flashcard-reels/web",
    "build:web": "turbo run build --filter=@flashcard-reels/web",
    "start": "npm --workspace @flashcard-reels/mobile exec -- expo start",
    "android": "npm --workspace @flashcard-reels/mobile exec -- expo start --android",
    "ios": "npm --workspace @flashcard-reels/mobile exec -- expo start --ios",
    "web:mobile": "npm --workspace @flashcard-reels/mobile exec -- expo start --web",
    "build": "turbo run build",
    "format": "oxfmt --write . && node apps/mobile/scripts/format-react-component-conventions.mjs --write && oxfmt --write .",
    "format:check": "oxfmt --check . && node apps/mobile/scripts/format-react-component-conventions.mjs",
    "format:mobile": "npm run format -w @flashcard-reels/mobile",
    "format:web": "npm run format -w @flashcard-reels/web",
    "conventions": "node apps/mobile/scripts/check-conventions.mjs",
    "check:architecture": "npm run test:architecture -w @flashcard-reels/mobile",
    "check:mobile": "npm run check -w @flashcard-reels/mobile",
    "check:web": "npm run check -w @flashcard-reels/web",
    "check:tokens": "npm run check -w @flashcard-reels/design-tokens",
    "check:android": "npm run check:android -w @flashcard-reels/mobile",
    "doctor": "npm run doctor -w @flashcard-reels/mobile",
    "lint": "npm run typegen -w @flashcard-reels/web && oxlint --type-aware --deny-warnings .",
    "lint:mobile": "npm run lint -w @flashcard-reels/mobile",
    "lint:web": "npm run lint -w @flashcard-reels/web",
    "lint:report": "npm run typegen -w @flashcard-reels/web && oxlint --type-aware .",
    "lint:strict": "npm run typegen -w @flashcard-reels/web && oxlint --type-aware --deny-warnings .",
    "test": "turbo run test",
    "test:mobile": "npm run test -w @flashcard-reels/mobile",
    "test:web": "npm run test -w @flashcard-reels/web",
    "typecheck": "turbo run typecheck",
    "typecheck:mobile": "npm run typecheck -w @flashcard-reels/mobile",
    "typecheck:tokens": "npm run typecheck -w @flashcard-reels/design-tokens",
    "typecheck:web": "npm run typecheck -w @flashcard-reels/web",
    "check": "npm run format:check && npm run conventions && npm run lint && npm run typecheck && npm run check:architecture",
    "verify": "npm run check && npm test && npm run build",
    "verify:mobile": "npm run verify -w @flashcard-reels/mobile",
    "r2:push-decks": "node --experimental-strip-types --env-file=apps/web/.env.local scripts/push-decks-to-r2.mjs"
  },
  "devDependencies": {
    "oxfmt": "latest",
    "oxlint": "latest",
    "oxlint-tsgolint": "^7.0.2001",
    "turbo": "^2.5.8"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.6.0",
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  }
}
