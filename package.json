{
  "name": "flashcard-reels",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:mobile": "turbo run dev --filter=@flashcard-reels/mobile",
    "dev:web": "turbo run dev --filter=@flashcard-reels/web",
    "build": "turbo run build",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test:custom-rules": "node scripts/linting/tests/run-tests.mjs",
    "lint": "npm run typegen -w @flashcard-reels/web && oxlint .",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "check": "npm run format:check && npm run test:custom-rules && npm run lint && npm run typecheck",
    "verify": "npm run check && npm test && npm run check:dead-code && npm run build",
    "r2:push-decks": "node --conditions=react-server --env-file=apps/web/.env.local scripts/push-decks-to-r2.mjs",
    "lint:fix": "npm run typegen -w @flashcard-reels/web && oxlint --fix .",
    "check:dead-code": "knip"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@tanstack/eslint-plugin-query": "5.104.1",
    "fflate": "^0.8.3",
    "knip": "^6.34.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "turbo": "^2.5.8"
  },
  "overrides": {
    "query-string": {
      "decode-uri-component": "0.5.0"
    },
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "solid-js": {
      "seroval": "1.6.8",
      "seroval-plugins": "1.6.8"
    },
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@12.0.2",
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "better-sqlite3@13.0.3": false
  }
}
