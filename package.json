{
  "name": "flashcard-reels",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:mobile": "turbo run dev --filter=@flashcard-reels/mobile",
    "dev:web": "turbo run dev --filter=@flashcard-reels/web",
    "build": "turbo run build",
    "format": "oxfmt --write . && node apps/mobile/scripts/format-react-component-conventions.mjs --write && oxfmt --write .",
    "format:check": "oxfmt --check . && node apps/mobile/scripts/format-react-component-conventions.mjs",
    "conventions": "node apps/mobile/scripts/check-conventions.mjs",
    "test:lint-rules": "node scripts/linting/tests/run-tests.mjs",
    "lint": "npm run typegen -w @flashcard-reels/web && oxlint .",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "check": "npm run format:check && npm run conventions && npm run lint && npm run typecheck && npm run test:lint-rules",
    "verify": "npm run check && npm test && npm run check:dead-code && npm run build",
    "r2:push-decks": "node --experimental-strip-types --env-file=apps/web/.env.local scripts/push-decks-to-r2.mjs",
    "lint:fix": "npm run typegen -w @flashcard-reels/web && oxlint --fix .",
    "check:dead-code": "knip"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.11.0",
    "fflate": "^0.8.3",
    "knip": "^6.34.0",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "turbo": "^2.5.8"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.6.0",
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  }
}
