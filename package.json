{
  "name": "flashcard-reels",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "android:machine:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android-machine.ps1 -Action Start",
    "android:machine:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android-machine.ps1 -Action Stop",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "format": "oxfmt --write . && node scripts/format-react-component-conventions.mjs --write && oxfmt --write .",
    "format:check": "oxfmt --check . && node scripts/format-react-component-conventions.mjs",
    "conventions": "node scripts/check-conventions.mjs",
    "lint": "oxlint --type-aware --quiet .",
    "lint:report": "oxlint --type-aware .",
    "lint:strict": "oxlint --type-aware --deny-warnings .",
    "typecheck": "tsc --noEmit",
    "test:architecture": "node tools/oxlint-plugin-flashcards/tests/rules.test.js",
    "check:dead-code": "knip",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "decks:packages": "node --experimental-strip-types scripts/generate-demo-deck-package.mjs",
    "decks:inspect": "node --experimental-strip-types scripts/inspect-deck-package.mjs",
    "decks:test:generate": "node --experimental-strip-types scripts/generate-test-deck-package.mjs",
    "decks:check": "node scripts/assert-bundled-deck-packages.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:preferences": "vitest run tests/unit/preferences.test.ts tests/unit/theme.test.ts tests/unit/study-control-layout.test.ts tests/unit/haptics.test.ts tests/unit/hold-to-focus.test.ts",
    "check": "npm run format:check && npm run conventions && npm run lint && npm run typecheck",
    "doctor": "expo-doctor",
    "check:android": "npm run decks:check && expo export --platform android",
    "verify": "npm run check && npm run lint:report && npm run test:run && npm run db:check && npm run check:dead-code && npm run test:architecture && npm run doctor && npm run check:android"
  },
  "dependencies": {
    "@expo/ui": "~57.0.17",
    "@shopify/flash-list": "2.0.2",
    "drizzle-orm": "^0.45.2",
    "expo": "~57.0.22",
    "expo-asset": "~57.0.16",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.3",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.21",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "fflate": "^0.8.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-pager-view": "8.0.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-tab-view": "^4.3.2",
    "react-native-toast-message": "^2.5.2",
    "react-native-web": "~0.21.0",
    "ts-fsrs": "5.4.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.1",
    "@types/react": "~19.2.2",
    "babel-plugin-inline-import": "^3.0.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.10.0",
    "expo-doctor": "1.20.4",
    "knip": "^6.34.0",
    "oxfmt": "latest",
    "oxlint": "latest",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "query-string": {
      "decode-uri-component": "0.5.0"
    },
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "better-sqlite3@13.0.3": true
  }
}
