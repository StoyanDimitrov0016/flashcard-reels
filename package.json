{
  "name": "flashcard-reels",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:mobile": "turbo run dev --filter=@flashcard-reels/mobile",
    "dev:web": "turbo run dev --filter=@flashcard-reels/web",
    "start": "npm --workspace @flashcard-reels/mobile exec -- expo start",
    "android": "npm --workspace @flashcard-reels/mobile exec -- expo start --android",
    "ios": "npm --workspace @flashcard-reels/mobile exec -- expo start --ios",
    "web:mobile": "npm --workspace @flashcard-reels/mobile exec -- expo start --web",
    "build": "turbo run build",
    "format": "oxfmt --write . && node apps/mobile/scripts/format-react-component-conventions.mjs --write && oxfmt --write .",
    "format:check": "oxfmt --check . && node apps/mobile/scripts/format-react-component-conventions.mjs",
    "conventions": "node apps/mobile/scripts/check-conventions.mjs",
    "lint": "oxlint --type-aware --quiet .",
    "lint:report": "oxlint --type-aware .",
    "lint:strict": "oxlint --type-aware --deny-warnings .",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "check": "npm run format:check && npm run conventions && npm run lint && npm run typecheck",
    "r2:push-decks": "node --experimental-strip-types --env-file=apps/web/.env.local scripts/push-decks-to-r2.mjs"
  },
  "devDependencies": {
    "oxfmt": "latest",
    "oxlint": "latest",
    "oxlint-tsgolint": "^7.0.2001",
    "turbo": "^2.5.8"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.6.0",
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  }
}
