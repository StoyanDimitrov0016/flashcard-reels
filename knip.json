{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.mjs"],
      "project": ["scripts/**/*.mjs"]
    },
    "apps/mobile": {
      "project": ["src/**/*.{ts,tsx}", "scripts/**/*.mjs", "tests/**/*.ts"],
      "ignoreDependencies": ["expo-updates", "react-native-pager-view"]
    },
    "apps/web": {
      "entry": ["tests/server-only.ts"]
    },
    "packages/design-tokens": {}
  }
}
