# Internal shared-password access
INTERNAL_APP_PASSWORD=
# Generate independently, for example: openssl rand -base64 32
AUTH_SESSION_SECRET=
# Leave unset: Vercel uses its HTTPS origin; localhost uses direct HTTPS R2 downloads.
# Optional LAN override for compact local QR codes, only if the phone can reach
# this computer's web server, e.g. http://192.168.1.20:3000. Never use localhost.
DECK_TRANSFER_ORIGIN=

# Which published channel the portal reads: dev (test decks) or prod (daily decks)
DECK_CHANNEL=dev

# Cloudflare R2 S3 API credentials
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=flashcard-reels

# Development only: serve .fcrdeck files from this folder instead of R2
LOCAL_DECKS_DIR=
