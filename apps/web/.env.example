# Internal shared-password access
INTERNAL_APP_PASSWORD=
# Generate independently, for example: openssl rand -base64 32
AUTH_SESSION_SECRET=
# Optional fixed origin; leave unset on Vercel to use the incoming HTTPS origin
# For same-Wi-Fi phone testing, use this computer's LAN IP, e.g. http://192.168.1.20:3000
# Do not use localhost: on the phone it points to the phone itself.
DECK_TRANSFER_ORIGIN=

# Cloudflare R2 S3 API credentials
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=flashcard-reels

# Development only: serve .fcrdeck files from this folder instead of R2
LOCAL_DECKS_DIR=
