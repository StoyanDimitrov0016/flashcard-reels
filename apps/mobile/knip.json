{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/app/**/*.{ts,tsx}",
    "src/features/learning-engine/index.ts",
    "scripts/**/*.mjs",
    "*.config.{cjs,ts}",
    "tests/**/*.test.ts"
  ],
  "ignoreBinaries": ["oxfmt", "oxlint"],
  "project": ["src/**/*.{ts,tsx}", "scripts/**/*.mjs", "tests/**/*.ts"],
  "ignoreDependencies": ["expo-updates", "react-native-pager-view", "react-native-tab-view"]
}
